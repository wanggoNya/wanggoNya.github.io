{% assign navigation = site.data.navigation[include.nav] %}

<nav class="nav__list nav__list--always">
  {% if page.sidebar.title %}<h3 class="nav__title" style="padding-left: 0;">{{ page.sidebar.title }}</h3>{% endif %}
  <h3 class="nav__category-title">Category <span class="nav__count">({{ site.posts | size }})</span></h3>
  <ul class="nav__items">
    {% for nav in navigation %}
      {%- assign count = site.categories[nav.title] | size -%}
      <li>
        {% if nav.url %}
          <a href="{{ nav.url | relative_url }}" class="nav__cat{% if nav.url == page.url %} active{% endif %}{% if count == 0 %} nav__cat--empty{% endif %}">
            <span class="nav__sub-title">{{ nav.title }}</span>
            <span class="nav__count">({{ count }})</span>
          </a>
        {% else %}
          <span class="nav__sub-title">{{ nav.title }}</span>
          <hr>
        {% endif %}

        {% if nav.children != null %}
        <ul>
          {% for child in nav.children %}
            {%- assign child_count = site.categories[child.title] | size -%}
            <li><a href="{{ child.url | relative_url }}"{% if child.url == page.url %} class="active"{% endif %}>{{ child.title }} <span class="nav__count">({{ child_count }})</span></a></li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
